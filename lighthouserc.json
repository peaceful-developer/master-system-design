{
  "ci": {
    "collect": {
      "startServerCommand": "npx tsx scripts/serve-static.ts --port 4310",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4310/master-system-design/",
        "http://localhost:4310/master-system-design/learn/foundations/how-the-web-works/",
        "http://localhost:4310/master-system-design/case-studies/url-shortener/",
        "http://localhost:4310/master-system-design/case-studies/",
        "http://localhost:4310/master-system-design/playbooks/back-of-envelope-estimation/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

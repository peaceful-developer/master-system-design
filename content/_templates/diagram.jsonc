// Template: diagram. For a case study, copy to content/case-studies/<slug>/diagram.json with the id <slug>-hld;
// for a worked example, copy to content/diagrams/<id>.json. Replace every {{…}},
// delete all // comment lines (JSON has no comments), then run `npm run validate-content`.
{
  // Referenced as ::diagram{id="…"} and by the diagram field in frontmatter.
  "id": "{{diagram-id}}",
  // Read aloud by screen readers and shown under the diagram.
  "title": "{{Title}}: {{what the diagram shows}}",
  // 5–12 nodes for a case study. Each node is 168 × 72; place them on a grid such as
  // x = 0, 250, 500, 760 and y = 0, 170, 340, 510, flowing left to right.
  "nodes": [
    // type is a component from content/components.json. Keep labels short (about 14 characters):
    // longer ones spill out of the node. config.instances (optional) shows "×3".
    { "id": "client", "type": "client", "label": "{{Clients}}", "position": { "x": 0, "y": 170 } },
    {
      "id": "app",
      "type": "app-server",
      "label": "{{Service}}",
      "position": { "x": 250, "y": 170 },
      "config": { "instances": 3 }
    },
    { "id": "cache", "type": "cache", "label": "{{Cache}}", "position": { "x": 500, "y": 0 } }
  ],
  // Straight arrows between node centers. Don't let one pass through another node.
  // label (optional) is 1–3 words that fit the gap between the two nodes.
  "edges": [
    { "id": "e1", "from": "client", "to": "app", "label": "{{requests}}" },
    { "id": "e2", "from": "app", "to": "cache", "label": "{{read}}" }
  ]
}

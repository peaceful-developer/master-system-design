{
  "id": "url-shortener-hld",
  "title": "URL shortener: high-level design",
  "nodes": [
    {
      "id": "client",
      "type": "client",
      "label": "Browser or app",
      "position": { "x": 0, "y": 150 }
    },
    { "id": "cdn", "type": "cdn", "label": "CDN (edge)", "position": { "x": 250, "y": 0 } },
    {
      "id": "lb",
      "type": "load-balancer",
      "label": "Load balancer",
      "position": { "x": 250, "y": 150 }
    },
    {
      "id": "app",
      "type": "app-server",
      "label": "Link service",
      "position": { "x": 500, "y": 150 },
      "config": { "instances": 4 }
    },
    { "id": "cache", "type": "cache", "label": "Link cache", "position": { "x": 750, "y": 0 } },
    {
      "id": "kv",
      "type": "nosql-store",
      "label": "Links (key-value)",
      "position": { "x": 750, "y": 150 },
      "config": { "instances": 6 }
    },
    {
      "id": "events",
      "type": "message-queue",
      "label": "Click events",
      "position": { "x": 500, "y": 320 }
    },
    {
      "id": "analytics",
      "type": "worker",
      "label": "Click counter",
      "position": { "x": 750, "y": 320 }
    }
  ],
  "edges": [
    { "id": "e1", "from": "client", "to": "cdn", "label": "redirect" },
    { "id": "e2", "from": "client", "to": "lb", "label": "create" },
    { "id": "e3", "from": "cdn", "to": "lb", "label": "edge miss" },
    { "id": "e4", "from": "lb", "to": "app" },
    { "id": "e5", "from": "app", "to": "cache", "label": "lookup code", "config": { "ratio": 1 } },
    {
      "id": "e6",
      "from": "app",
      "to": "kv",
      "label": "miss or create",
      "config": { "ratio": 0.1 }
    },
    { "id": "e7", "from": "app", "to": "events", "label": "redirected" },
    { "id": "e8", "from": "events", "to": "analytics" }
  ]

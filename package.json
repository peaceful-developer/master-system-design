{
  "name": "system-design-lab",
  "version": "0.1.0",
  "description": "Open-source, frontend-only learning app for system design, from foundations to LLM systems.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/peaceful-developer/master-system-design.git"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --no-watch && vitest run --config vitest.scripts.config.mts",
    "test:scripts": "vitest run --config vitest.scripts.config.mts",
    "lint": "eslint . && prettier --check . && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.2",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}

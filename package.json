{
  "name": "system-design-lab",
  "version": "0.1.0",
  "description": "Open-source, frontend-only learning app for system design, from foundations to LLM systems.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/peaceful-developer/master-system-design.git"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run content:build && concurrently -k -n content,ng -c green,magenta \"npm:content:watch\" \"ng serve\"",
    "build": "npm run content:build && ng build",
    "postbuild": "tsx scripts/postbuild.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:watch": "tsx scripts/build-content.ts --watch",
    "validate-content": "tsx scripts/build-content.ts --check",
    "test": "npm run content:build && ng test --no-watch && vitest run --config vitest.scripts.config.mts",
    "test:scripts": "vitest run --config vitest.scripts.config.mts",
    "lint": "eslint . && prettier --check . && tsc -p tsconfig.scripts.json --noEmit",
    "e2e": "playwright test",
    "serve": "tsx scripts/serve-static.ts",
    "figures:render": "tsx scripts/render-figures.ts",
    "demo:capture": "tsx scripts/capture-demo.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.2",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "minisearch": "7.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "angular-eslint": "22.6.0",
    "chokidar": "5.0.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "gifenc": "1.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "jsdom": "30.1.2",
    "pngjs": "7.0.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "property-information": "7.2.0",
    "rehype-parse": "9.0.1",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
